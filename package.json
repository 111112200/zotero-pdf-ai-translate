{
  "name": "zotero-pdf-ai-translate",
  "type": "module",
  "version": "0.1.2",
  "description": "Translate whole PDFs inside Zotero and export side-by-side bilingual PDFs using any OpenAI-compatible AI service.",
  "config": {
    "addonName": "PDF AI Translate",
    "addonID": "pdf-ai-translate@dsh.local",
    "addonRef": "pdfaitranslate",
    "addonInstance": "PDFAITranslate",
    "prefsPrefix": "extensions.zotero.pdfaitranslate"
  },
  "author": "111112200",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/111112200/zotero-pdf-ai-translate.git"
  },
  "bugs": {
    "url": "https://github.com/111112200/zotero-pdf-ai-translate/issues"
  },
  "homepage": "https://github.com/111112200/zotero-pdf-ai-translate#readme",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "build:xpi": "node tools/sync-pdfjs.mjs && zotero-plugin build",
    "typecheck": "tsc --noEmit",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "prebuild": "node tools/sync-pdfjs.mjs",
    "prestart": "node tools/sync-pdfjs.mjs"
  },
  "dependencies": {
    "fontkit": "^2.0.4",
    "pdf-lib": "^1.17.1",
    "zotero-plugin-toolkit": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "pdfjs-dist": "^4.10.38",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@swc/core@1.16.13": true
  }
}
